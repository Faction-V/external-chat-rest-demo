# Copy to .env.local and fill in. .env.local is gitignored.

# --- Required: which collection the embed key is scoped to -------------------
VITE_ORG_ID=00000000-0000-0000-0000-000000000000
VITE_COLLECTION_ID=00000000-0000-0000-0000-000000000000

# Embed API key (eak_...). Created in the admin UI, or:
#   POST /{orgid}/collections/{collection_id}/external-chat/keys
# This key is visible to anyone who loads the page — that is by design, the
# same as the iframe's ?apiKey= query param. Restrict it with the key's
# allowed_domains + rate_limit_per_minute settings, not by hiding it.
VITE_EMBED_API_KEY=eak_your_key_here

# --- How the browser reaches the API ----------------------------------------
# Leave VITE_API_BASE_URL unset to route through this dev server's /api proxy
# (same-origin, no CORS). Point VITE_PLATFORM_API_URL at the API's public app.
VITE_PLATFORM_API_URL=http://localhost:8811/public

# Set this to call the API directly from the browser instead of proxying.
# Requires CORS on the API's public app and this page's host in the key's
# allowed_domains. Example:
# VITE_API_BASE_URL=https://api.staging.capitol.ai/public

# Dev server port
VITE_PORT=5174
